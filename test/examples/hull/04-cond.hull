object CondOps {
  code {
    function select(flag :  sum{(unit + unit)}, a : word, b : word) -> word {
      return if<word> flag then a else b
    }
    function selectPair(flag :  sum{(unit + unit)}, p : word * word, q : word * word) -> word * word {
      return if<word * word> flag then p else q
    }
  }
}
