// ERC20 core capability, with its own storage.
//
// The ERC20 ledger (balances, allowances, total supply) lives in this module's
// own ERC-7201 namespace, laid out at three sub-slots of the namespace root:
//   root + 0 : balances       mapping(address => uint256)
//   root + 1 : allowances     mapping(address => mapping(address => uint256))
//   root + 2 : totalSupply    uint256
// Provides HasLedger / HasSupply / HasAllowance over AppStore and the reusable
// ERC20 internals (coreUpdate, spendAllowance, approveVal). Transfer/Approval are
// emitted with raw log3 (there is no emit sugar).

import std.{*};
import std.opcodes.{sload, sstore, log3, mstore};
import store.{*};

export { HasLedger, HasSupply, HasAllowance, coreUpdate, spendAllowance, approveVal };

forall self . class self : HasLedger {
  function balanceOf(s : self, a : address) -> uint256;
  function setBalance(s : self, a : address, v : uint256) -> ();
}

forall self . class self : HasSupply {
  function totalSupply(s : self) -> uint256;
  function setTotalSupply(s : self, v : uint256) -> ();
}

forall self . class self : HasAllowance {
  function allowanceOf(s : self, o : address, sp : address) -> uint256;
  function setAllowance(s : self, o : address, sp : address, v : uint256) -> ();
}

// This module's namespace and its three sub-slots.
function erc20Root() -> word { return Typedef.rep(erc7201("mytoken.storage.ERC20")); }
function balancesBase() -> word { return erc20Root(); }
function allowancesBase() -> word { return erc20Root() + 1; }
function totalSupplySlot() -> word { return erc20Root() + 2; }

// mapping element slots (keccak of base with key, matching the storage convention).
function balanceSlot(a : address) -> word { return hash2(balancesBase(), Typedef.rep(a)); }
function allowanceSlot(o : address, sp : address) -> word {
  return hash2(hash2(allowancesBase(), Typedef.rep(o)), Typedef.rep(sp));
}

instance AppStore : HasLedger {
  function balanceOf(s : AppStore, a : address) -> uint256 { return uint256(sload(balanceSlot(a))); }
  function setBalance(s : AppStore, a : address, v : uint256) -> () { sstore(balanceSlot(a), Typedef.rep(v)); }
}

instance AppStore : HasSupply {
  function totalSupply(s : AppStore) -> uint256 { return uint256(sload(totalSupplySlot())); }
  function setTotalSupply(s : AppStore, v : uint256) -> () { sstore(totalSupplySlot(), Typedef.rep(v)); }
}

instance AppStore : HasAllowance {
  function allowanceOf(s : AppStore, o : address, sp : address) -> uint256 {
    return uint256(sload(allowanceSlot(o, sp)));
  }
  function setAllowance(s : AppStore, o : address, sp : address, v : uint256) -> () {
    sstore(allowanceSlot(o, sp), Typedef.rep(v));
  }
}

function emitTransfer(from : address, to : address, value : uint256) -> () {
  let p : word = get_free_memory();
  mstore(p, Typedef.rep(value));
  log3(p, 32, keccakLit("Transfer(address,address,uint256)"), Typedef.rep(from), Typedef.rep(to));
}

function emitApproval(o : address, sp : address, value : uint256) -> () {
  let p : word = get_free_memory();
  mstore(p, Typedef.rep(value));
  log3(p, 32, keccakLit("Approval(address,address,uint256)"), Typedef.rep(o), Typedef.rep(sp));
}

// The ERC20 _update seam: mint (from == 0), burn (to == 0) or move.
forall self . self:HasLedger, self:HasSupply =>
function coreUpdate(s : self, from : address, to : address, value : uint256) -> () {
  if (from == address(0)) {
    let ts : uint256 = HasSupply.totalSupply(s);
    let nts : uint256 = Num.add(ts, value);
    require(nts >= ts, Error(0x4e487b71));       // overflow -> Panic(0x11)-like
    HasSupply.setTotalSupply(s, nts);
  } else {
    let bf : uint256 = HasLedger.balanceOf(s, from);
    require(bf >= value, Error(0xe450d38c));     // ERC20InsufficientBalance
    HasLedger.setBalance(s, from, Num.sub(bf, value));
  }
  if (to == address(0)) {
    let ts2 : uint256 = HasSupply.totalSupply(s);
    HasSupply.setTotalSupply(s, Num.sub(ts2, value));
  } else {
    let bt : uint256 = HasLedger.balanceOf(s, to);
    HasLedger.setBalance(s, to, Num.add(bt, value));
  }
  emitTransfer(from, to, value);
}

forall self . self:HasAllowance =>
function spendAllowance(s : self, o : address, sp : address, value : uint256) -> () {
  let cur : uint256 = HasAllowance.allowanceOf(s, o, sp);
  if (cur != (Num.maxVal() : uint256)) {
    require(cur >= value, Error(0xfb8f41b2));    // ERC20InsufficientAllowance
    HasAllowance.setAllowance(s, o, sp, Num.sub(cur, value));
  }
}

forall self . self:HasAllowance =>
function approveVal(s : self, o : address, sp : address, value : uint256) -> () {
  HasAllowance.setAllowance(s, o, sp, value);
  emitApproval(o, sp, value);
}
