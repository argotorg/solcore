import std.{*};
import std.dispatch.{*};

function caller() -> address {
  let res : word;
  assembly { res := caller() }
  return address(res);
}

interface HasOwner {
  function getOwner() -> address;
}

// Abstract base: owner state + guard, exactly like OZ Ownable.
contract Ownable implements HasOwner {
  owner : address;

  constructor() {
    owner = caller();
  }

  public function getOwner() -> address {
    return owner;
  }

  public function changeOwner(newOwner : address) -> () {
    require(caller() == owner, Error(0x12b0c500));
    owner = newOwner;
  }
}

// Child: adds its own field + method, inherits owner/getOwner/changeOwner.
contract Counter inherits Ownable {
  count : uint256;

  constructor() {
    owner = caller();
    count = 0;
  }

  public function bump() -> () {
    require(caller() == owner, Error(0x12b0c500));
    count = count + 1;
  }

  public function getCount() -> uint256 {
    return count;
  }
}
