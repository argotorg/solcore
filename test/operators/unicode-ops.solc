// Operator symbols may be built from Unicode mathematical-operator characters
// (U+2200..U+23FF), not only ASCII. Here (⊕) and (⊗) are binary infix operators
// with different precedences, and (√) is a Unicode prefix operator.
import std.{addWord};
pragma no-patterson-condition ;
pragma no-coverage-condition ;
pragma no-bounded-variable-condition ;

infixl 60 (⊕) => addWord;
infixl 70 (⊗) => mulWord;
prefix 80 (√) => halfWord;

function mulWord(x : word, y : word) -> word {
  let r : word;
  assembly { r := mul(x, y) }
  return r;
}

function halfWord(x : word) -> word {
  let r : word;
  assembly { r := div(x, 2) }
  return r;
}

contract UnicodeOps {
  function main() -> word {
    // (⊗) at precedence 70 binds tighter than (⊕) at 60:
    // 2 ⊕ 3 ⊗ 4  =  2 ⊕ (3 ⊗ 4)  =  2 ⊕ 12  =  14
    let a : word = 2 ⊕ 3 ⊗ 4;
    // prefix (√) then (⊕): (√ 14) ⊕ 1 = 7 ⊕ 1 = 8
    let b : word = √ a ⊕ 1;
    return b;
  }
}
