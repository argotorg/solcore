// Declares a user-defined infix operator (^^) for exponentiation and uses it.
import std.{*};
pragma no-patterson-condition ;
pragma no-coverage-condition ;
pragma no-bounded-variable-condition ;

infixl 70 (**) => pow;

function pow(b : word, e : word) -> word {
  let r : word;
  assembly { r := exp(b, e) }
  return r;
}

contract Basic {
  function main() -> word {
    return 2 ** 10;    // 1024
  }
}
