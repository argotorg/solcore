// OpenZeppelin ERC20 in Core Solidity — FLAT version (NO inheritance).
//
// Behaviorally identical to oz/ERC20Inherit.solc, but written as a single
// contract with no inherits: the ERC20 core, the Pausable guard and the Capped
// check are all inlined into one update. The differential test
// (oz/test/differential.sh) runs this, the inheritance version, and the OZ
// reference against the same vectors and checks all three agree byte-for-byte —
// so it doubles as a check that the inheritance machinery preserves semantics.
//
// The inline update reproduces the order the diamond linearization
// [Token, ERC20Capped, ERC20Pausable, ERC20] produces: pause guard -> balance
// movement -> cap check.

import std.{*};
import std.dispatch.{*};
import std.opcodes as Op;

function caller() -> address {
  let res : word;
  assembly { res := caller() }
  return address(res);
}
function msgSender() -> address { return caller(); }

function emitTransfer(from: address, to: address, value: uint256) -> () {
  Op.mstore(0, Typedef.rep(value));
  Op.log3( 0, 32, keccakLit("Transfer(address,address,uint256)")
         , Typedef.rep(from), Typedef.rep(to));
}
function emitApproval(owner: address, spender: address, value: uint256) -> () {
  Op.mstore(0, Typedef.rep(value));
  Op.log3( 0, 32, keccakLit("Approval(address,address,uint256)")
         , Typedef.rep(owner), Typedef.rep(spender));
}

function revertInsufficientBalance(sender: address, bal: uint256, needed: uint256) -> () {
  Op.mstore(0, 0xe450d38c); 
  Op.mstore(32, Typedef.rep(sender)); 
  Op.mstore(64, Typedef.rep(bal)); 
  Op.mstore(96, Typedef.rep(needed)); 
  Op.revert(28, 100);
}

function revertInsufficientAllowance(spender: address, allowance: uint256, needed: uint256) -> () {
  Op.mstore(0, 0xfb8f41b2); 
  Op.mstore(32, Typedef.rep(spender)); Op.mstore(64, Typedef.rep(allowance)); 
  Op.mstore(96, Typedef.rep(needed)); Op.revert(28, 100);
}

function revertInvalidReceiver(receiver: address) -> () { 
  Op.mstore(0, 0xec442f05); 
  Op.mstore(32, Typedef.rep(receiver)); 
  Op.revert(28, 36); 
}

function revertInvalidSender(sender: address) -> () { 
  Op.mstore(0, 0x96c6fd1e); 
  Op.mstore(32, Typedef.rep(sender)); 
  Op.revert(28, 36); 
}

function revertInvalidApprover(approver: address) -> () { 
  Op.mstore(0, 0xe602df05); 
  Op.mstore(32, Typedef.rep(approver)); 
  Op.revert(28, 36); 
}

function revertInvalidSpender(spender: address) -> () { 
  Op.mstore(0, 0x94280d62); 
  Op.mstore(32, Typedef.rep(spender)); 
  Op.revert(28, 36); 
}

function revertInvalidCap(cap: uint256) -> () { 
  Op.mstore(0, 0x392e1e27); 
  Op.mstore(32, Typedef.rep(cap)); 
  Op.revert(28, 36); 
}

function revertExceededCap(increasedSupply: uint256, cap: uint256) -> () { 
  Op.mstore(0, 0x9e79f854); 
  Op.mstore(32, Typedef.rep(increasedSupply)); 
  Op.mstore(64, Typedef.rep(cap)); 
  Op.revert(28, 68); 
}

function revertOverflow() -> () { 
  Op.mstore(0, 0x4e487b71); 
  Op.mstore(32, 0x11); 
  Op.revert(28, 36); 
}

contract Token {
  balances_    : mapping(address, uint256);
  allowances_  : mapping(address, mapping(address, uint256));
  totalSupply_ : uint256;
  name_        : string;
  symbol_      : string;
  paused_      : uint256;
  cap_         : uint256;

  constructor(nm : memory(string), sym : memory(string), initCap : uint256) {
    name_ = nm;
    symbol_ = sym;
    if (initCap == 0) { revertInvalidCap(0); }
    cap_ = initCap;
    paused_ = 0;
  }

  public function name() -> memory(string) { 
    return name_; 
  }
  
  public function symbol() -> memory(string) { 
    return symbol_; 
  }
  
  public function decimals() -> uint256 { 
    return 18; 
  }
  
  public function totalSupply() -> uint256 { 
    return totalSupply_; 
  }
  
  public function balanceOf(account : address) -> uint256 { 
    return balances_[account]; 
  }
  
  public function allowance(owner : address, spender : address) -> uint256 { 
    return allowances_[owner][spender]; 
  }
  
  public function paused() -> uint256 { 
    return paused_; 
  }
  
  public function cap() -> uint256 { 
    return cap_; 
  }
  
  public function pause() -> () { 
    paused_ = 1; 
  }
  
  public function unpause() -> () { 
    paused_ = 0; 
  }

  public function transfer(to : address, value : uint256) -> bool {
    transferTokens(msgSender(), to, value);
    return true;
  }

  public function approve(spender : address, value : uint256) -> bool {
    approveTokens(msgSender(), spender, value);
    return true;
  }

  public function transferFrom(from : address, to : address, value : uint256) -> bool {
    let spender = msgSender();
    spendAllowance(from, spender, value);
    transferTokens(from, to, value);
    return true;
  }

  public function mint(to : address, value : uint256) -> () { 
    mintTokens(to, value); 
  }

  public function burn(value : uint256) -> () { 
    burnTokens(msgSender(), value); 
  }
  
  public function burnFrom(account : address, value : uint256) -> () {
    spendAllowance(account, msgSender(), value);
    burnTokens(account, value);
  }

  function transferTokens(from : address, to : address, value : uint256) -> () {
    if (from == address(0)) { 
      revertInvalidSender(address(0)); 
    }
    if (to == address(0)) { 
      revertInvalidReceiver(address(0)); 
    }
    update(from, to, value);
  }

  function mintTokens(account : address, value : uint256) -> () {
    if (account == address(0)) { 
      revertInvalidReceiver(address(0)); 
    }
    update(address(0), account, value);
  }

  function burnTokens(account : address, value : uint256) -> () {
    if (account == address(0)) { 
      revertInvalidSender(address(0)); 
    }
    update(account, address(0), value);
  }

  function approveTokens(owner : address, spender : address, value : uint256) -> () {
    if (owner == address(0)) { 
      revertInvalidApprover(address(0)); 
    }
    if (spender == address(0)) { 
      revertInvalidSpender(address(0)); 
    }
    allowances_[owner][spender] = value;
    emitApproval(owner, spender, value);
  }

  function spendAllowance(owner : address, spender : address, value : uint256) -> () {
    let currentAllowance = allowances_[owner][spender];
    let mx : uint256 = maxVal();
    if (currentAllowance < mx) {
      if (currentAllowance < value) { 
        revertInsufficientAllowance(spender, currentAllowance, value); 
      }
      allowances_[owner][spender] = currentAllowance - value;
    }
  }

  function update(from : address, to : address, value : uint256) -> () {
    require(paused_ == 0, Error(0xd93c0665)); // whenNotPaused (ERC20Pausable)

    if (from == address(0)) {
      let newSupply = totalSupply_ + value;
      if (newSupply < totalSupply_) { 
        revertOverflow(); 
      }
      totalSupply_ = newSupply;
    } else {
      let fromBalance = balances_[from];
      if (fromBalance < value) { 
        revertInsufficientBalance(from, fromBalance, value); 
      }
      balances_[from] = fromBalance - value;
    }
    if (to == address(0)) {
      totalSupply_ = totalSupply_ - value;
    } else {
      balances_[to] = balances_[to] + value;
    }
    emitTransfer(from, to, value);

    if (from == address(0)) { // cap check (ERC20Capped), after the mint
      if (totalSupply_ > cap_) { 
        revertExceededCap(totalSupply_, cap_); 
      }
    }
  }
}
