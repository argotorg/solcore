  keccak256_,
  keccakLit,
  le,
  lidx,
  loadBytesFromStorage,
  log1,
  lt,
  mapping(*),
  maxVal,
  memberAccessBase,
  memory(*),
  memory_ref,
  mulmod,
  ne,
  not,
  or,
  out_of_bounds,
  raw_call,
  readStorage,
  returndata(*),
  revertLit,
